#define TRIG 9
#define ECHO 10

float weight = 0;     
long duration;
float distance;

void setup() {

  Serial.begin(9600);

  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);

}

void loop() {


  weight = random(1,7); 


  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);

  duration = pulseIn(ECHO, HIGH);
  distance = duration * 0.034 / 2;

  Serial.print("Weight: ");
  Serial.print(weight);
  Serial.print(" kg | ");

  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" cm");


  if(weight >= 5 && distance <= 10)
  {
    Serial.println("Garbage Can is FULL");
  }
  else
  {
    Serial.println("Garbage Can NOT FULL");
  }

  Serial.println("--------------------");

  delay(2000);
}
